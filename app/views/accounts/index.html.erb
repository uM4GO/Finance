<div class="p-3">
    <h1>Listagem de contas</h1>
</div>
<div class="px-3">
    <table class="table table-striped">
        <thead class="table-info">
            <th>Agencia da conta</th>
            <th>Número da conta</th>
            <th>Banco</th>
            <th>Saldo</th>
            <th>Ações</th>
        </thead>
        <% @accounts.each do |account| %>
        <tr>
            <td><%= account.agency_number %></td>
            <td><%= account.account_number %></td>
            <td><%= account.bank.name %></td>
            <td><%= account.total_saldo %></td>
            <td>
                <%= link_to "Editar", edit_account_path(account), class: "btn btn-primary btn-sm" %>
                <% if account.transactions.none?  %>
                    <%= link_to account_path(account),
                        data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" },
                        class: "btn btn-sm btn-danger" do %>
                            <b class="bi bi-trash">Excluir</b>
                    <% end %>
                <% else %>
                    <%= link_to "Transações", account_transactions_path(account), class: "btn btn-success btn-sm" %>
                <% end %> 
            </td>
        </tr>
        <% end %>
    </table>
</div>
<div class="ps-3">
    <%= link_to "Nova conta", new_account_path, class: "btn btn-primary" %>
</div>