<h1>Listagem de contas</h1>
<table>
    <th>
        <tr>
            <td>Agencia da conta</td>
            <td>Número da conta</td>
            <td>Banco</td>
            <td>Ações</td>
        </tr>
    </th>
    <% @accounts.each do |account| %>
        <tr>
            <td><%= account.agency_number %></td>
            <td><%= account.account_number %></td>
            <td><%= account.bank.name %></td>
            <td><%= link_to "Editar", edit_account_path(account) %>
            <%= button_to "Excluir", account, method: :delete %>
            </td>
        </tr>
    <% end %>
</table>
<%= link_to "Nova conta", new_account_path %>

