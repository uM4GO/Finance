<%= form_with(model: account) do |form| %>
    <% if account.errors.any? %>
        <div style="color: red">
            <h2><%= pluralize(account.errors.count, "error") %> prohibited this account from being saved:</h2>

            <ul>
                <% account.errors.each do |error| %>
                    <li><%= error.full_message %></li>
                <% end %>
            </ul>
        </div>
    <% end %>
    
    <div>
        <%= form.label :agency_number, class: "form-label" %>
        <%= form.text_field :agency_number, class: "form-control form-control-sm" %>
    </div>

    <div>
        <%= form.label :account_number, class: "form-label" %>
        <%= form.text_field :account_number, class: "form-control form-control-sm" %>
    </div>
    
    <div>
        <%= form.label :bank, class: "form-label" %>
        <%= form.select :bank_id, Bank.order(:name).map { |bank| [bank.name, bank.id] }, class: "form-control form-control-sm" %>
    </div>
    
    <div>
        <%= form.submit %>
    </div>
<% end %>