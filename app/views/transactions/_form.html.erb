<%= form_with(model: [@account, transaction]) do |form| %>
  <% if transaction.errors.any? %>
    <div style="color: red">
      <h2>
        <%= pluralize(transaction.errors.count, "error") %>
        prohibited this transaction from being saved:
      </h2>

      <ul>
        <% transaction.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

	<div class="d-flex p-2 ps-4 align-items-center col-md-3">
		<%= form.label :description, class: "form-label" %>	
		<div class="ps-3">
			<%= form.text_field :description, class: "form-control form-control-sm" %>
		</div>
	</div>
	
	<div class="d-flex p-2 ps-4 align-items-center col-md-3">
			<%= form.label :date, class: "form-label" %>
		<div class="ps-3">
			<%= form.date_field :date, class: "form-control form-control-sm" %>
		</div>
	</div>

	<div class="d-flex p-2 ps-4 align-items-center col-md-3">
		<%= form.label :transaction_type, class: "form-label" %>
		<div class="ps-3">
			<%= form.select :transaction_type,
					[['Crédito', 'credit'], ['Débito', 'debit']],
					{},
					class: "form-control form-control-sm" %>
		</div>
	</div>

	<div class="d-flex p-2 ps-4 align-items-center col-md-2">
    <%= form.label :amount,  class: "form-label" %>
		<div class="ps-3"> 
      <%= form.text_field :amount, class: "form-control form-control-sm" %>
    </div>
	</div>

  <div class="ps-4">
    <%= form.submit %>
  </div>
<% end %>