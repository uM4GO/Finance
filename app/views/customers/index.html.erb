<h1>Listagem de Clientes</h1>
<table>
    <tr>
        <th>Nome do cliente</th>
        <th>Endereço</th>
        <th>Data de nascimento</th>
        <th>CPF</th>
        <th>Tipo</th>
        <th>CEP</th>
        <th>Status</th>
        <th>Ações</th>
    </tr>
<% @customers.each do |customer| %>
    <tr>
        <td><%= customer.name %></td>
        <td><%= customer.address %></td>
        <td><%= customer.birth_date %></td>
        <td><%= customer.documento %></td>
        <td><%= customer.kind %></td>
        <td><%= customer.cep %></td>
        <td><%= customer.status %></td>
        <td><%= link_to "Editar", edit_customer_path(customer) %>
            <%= button_to "Excluir", customer, method: :delete %>
        </td>
    </tr>
<% end %>
</table>
<%= link_to "Novo cliente", new_customer_path %>