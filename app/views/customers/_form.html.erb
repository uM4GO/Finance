<%= form_with(model: customer) do |form| %>
    <% if customer.errors.any? %>
        <div style="color: red">
            <h2><%= pluralize(customer.errors.count, "error") %> prohibited this customer from being saved:</h2>

            <ul>
                <% customer.errors.each do |error| %>
                    <li><%= error.full_message %></li>
                <% end %>
            </ul>
        </div>
    <% end %>
    

    <div class="d-flex p-2 ps-4 align-items-start col-md-3">
        <%= form.label :name, class: "form-label" %>
        <div class="ps-3">
            <%= form.text_field :name, class: "form-control form-control-sm" %>
        </div>
    </div>

    <div class="d-flex p-2 ps-4 align-items-center col-md-3">
        <%= form.label :address, class: "form-label" %>
        <div class="ps-3">
            <%= form.text_field :address, class: "form-control form-control-sm" %>
        </div>
    </div>

    <div class="d-flex p-2 ps-4 align-items-center col-md-3">
        <%= form.label :birth_date, class: "form-label" %>
        <div class="ps-3">
            <%= form.date_field :birth_date, class: "form-control form-control-sm" %>
        </div>
    </div>

    <div class="d-flex p-2 ps-4 ps-4 align-items-center col-md-2">
        <%= form.label :documento, "Documento: ", class: "form-label" %>
        <div class="ps-3">
            <%= form.text_field :documento, class: "form-control form-control-sm" %>
        </div>
    </div>

    <div class="d-flex p-2 ps-4 align-items-center col-md-2">
        <%= form.label :kind, "Tipo de pessoa: ", class: "form-label text-nowrap" %>
        <div class="ps-3">
            <%= form.select :kind,
                options_for_select(customer_kind_options, Customer.kinds.keys),
                {},
                { class: "form-select", required: true } %>
        </div>
    </div>

    <div class="d-flex p-2 ps-4 align-items-center col-md-2">
        <%= form.label :cep, "CEP: ", class: "form-label" %>
        <div class="ps-3">
            <%= form.text_field :cep, class: "form-control form-control-sm" %>
        </div>
    </div>

    <div class="p-2 ps-4">
        <div class="form-check">
            <%= form.check_box :active, class: "form-check-input" %>
            <%= form.label :active, "Cliente ativo:", class: "form-check-label" %>
        </div>
    </div>

    <div class="ps-4">
        <%= form.submit class: "btn btn-info" %>
    </div>

<% end %>